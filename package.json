{
  "name": "qc-trousse-sdg",
  "version": "1.5.2",
  "description": "Trousse de développement du Système de design gouvernemental du Québec",
  "main": "index.js",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "preinstall": "npx only-allow yarn",
    "dev": "node scripts/build-dev.mjs --watch --serve",
    "build:dev": "node scripts/build-dev.mjs",
    "preversion": "./scripts/check-release-note.sh",
    "version": "./scripts/compile-doc.sh",
    "build": "node scripts/build-vite.mjs",
    "pretest": "yarn build && yarn build:dev",
    "test": "playwright test",
    "start": "sirv . --host 127.0.0.1 --port 5173 --dev",
    "build-grid-tokens": "node ./scripts/buildGridTokens.js",
    "build-icon-font": "node scripts/build-icon-font.js",
    "build-icon-doc": "node scripts/build-icon-doc.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Quebecca/qc_trousse_sdg.git"
  },
  "author": "MCE",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^26.4.0",
    "autoprefixer": "^10.5.4",
    "ejs": "^6.0.1",
    "fast-check": "^4.9.0",
    "glob": "^11.0.0",
    "highlight.js": "^11.12.0",
    "js-beautify": "^2.0.3",
    "postcss": "^8.5.26",
    "postcss-replace": "^2.0.0",
    "pretty": "^2.0.0",
    "sass": "^1.103.1",
    "sirv-cli": "^3.0.0",
    "svelte": "^5.57.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
