/.idea
/.kiro
.DS_Store
node_modules/
/sandbox

# Gestionnaire de paquets : yarn uniquement (voir packageManager + preinstall).
# package-lock.json ne doit pas être commité pour éviter la dérive avec yarn.lock.
package-lock.json

/public/js/rewrite-bs.js
/public/js/assets/asset-*
*dev.html

# Dossiers intermédiaires de Vite (build lib) — créés puis supprimés à chaque build.
/dist/.vite-tmp/
/.vite-tmp-dev/

# Sourcemaps : générées UNIQUEMENT par npm run dev (jamais par npm run build).
# Aide au debug local, jamais distribuées.
/public/js/*.map
/public/css/*.map
/dist/js/*.map
/dist/css/*.map

